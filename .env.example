# Nakanime public API (catalogue and episode sources)
NAKANIME_ORIGIN=https://nakanime.tv
NAKANIME_API_URL=https://nakanime.tv/api/sources/anime

# Naka private catalogue integration — fill only with official endpoints
# supplied for an authorized integration by the Naka backend.
NAKA_ORIGIN=https://naka.cx
NAKA_CATALOG_URL=
# Optional template; supports {type} and {id}, e.g. https://api.example.tld/media/{type}/{id}
NAKA_DETAIL_URL=
# Use a server-to-server API token/cookie if Naka's official API requires one.
# Never put your normal account password here.
NAKA_API_TOKEN=
NAKA_API_COOKIE=

HOST=127.0.0.1
PORT=3000
